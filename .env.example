# The two source files are mounted read-only and are never copied into the image.
GAMDL_COOKIES_FILE=./secrets/cookies.txt
RCLONE_CONFIG_FILE=./secrets/rclone.conf

GAMDL_IMAGE=gamdl-dual:latest
RCLONE_DESTINATION=music:music
GAMDL_RUN_INTERVAL=1h
GAMDL_RUN_IMMEDIATELY=true
GAMDL_RUN_ONCE=false
GAMDL_KEEP_LOCAL=false
GAMDL_DRY_RUN=false
GAMDL_QUEUES=us,cn
GAMDL_DOWNLOAD_TIMEOUT=3600
GAMDL_VERIFY_ATTEMPTS=6
GAMDL_VERIFY_DELAY=3
