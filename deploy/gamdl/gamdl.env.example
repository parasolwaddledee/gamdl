# Runtime settings read by gamdl_service inside the container.
RCLONE_DESTINATION=music:music
GAMDL_RUN_INTERVAL=6h
GAMDL_RUN_IMMEDIATELY=true
GAMDL_KEEP_LOCAL=false
GAMDL_DRY_RUN=false
GAMDL_QUEUES=us,cn
GAMDL_US_PLAYLIST=US_Pending
GAMDL_CN_PLAYLIST=CN_Pending
GAMDL_DOWNLOAD_TIMEOUT=3600
GAMDL_VERIFY_ATTEMPTS=6
GAMDL_VERIFY_DELAY=3
